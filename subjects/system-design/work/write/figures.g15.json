     "Cursor-based",
     "Efficient for large datasets",
     "Slightly more complex"
    ],
    [
     "Keyset-based",
     "Efficient",
     "Needs a unique, indexed key"
    ],
    [
     "Time-based",
     "Misses no new records",
     "Needs a reliable timestamp"
    ],
    [
     "Hybrid",
     "Best performance and flexibility",
     "Needs careful design"
    ]
   ],
