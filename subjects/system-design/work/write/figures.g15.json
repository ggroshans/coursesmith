 "sysd-msg-019": [
  {
   "type": "table",
   "caption": "A remote call passes through two stubs and two operating systems, and the reply comes back the same way.",
   "header": [
    "Step",
    "Who",
    "What happens"
   ],
   "rows": [
    [
     "1",
     "Caller",
     "Makes a local call, parameters on the stack"
    ],
    [
     "2",
     "Client stub",
     "Packs the parameters (marshalling), makes a system call"
    ],
    [
     "3",
     "Client OS",
     "Sends the message to the server machine"
    ],
    [
     "4",
     "Server OS",
     "Passes the incoming packets to the server stub"
    ],
    [
     "5",
     "Server stub",
     "Unpacks the parameters, calls the server procedure"
    ],
    [
     "6",
     "Reply",
     "Retraces the same steps in reverse"
    ]
   ],
   "sent_ids": [
