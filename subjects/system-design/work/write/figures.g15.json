 "sysd-msg-109": [
  {
   "type": "table",
   "caption": "The server proves it saw the handshake, then both sides leave HTTP behind.",
   "header": [
    "Step",
    "Who",
    "What happens"
   ],
   "rows": [
    [
     "1",
     "Client",
     "Sends an HTTP GET Upgrade request with a Sec-WebSocket-Key"
    ],
    [
     "2",
     "Server",
     "Appends a fixed GUID to the key, takes the SHA-1 hash, base64-encodes it"
    ],
    [
     "3",
     "Server",
     "Returns it in Sec-WebSocket-Accept with a 101 response"
    ],
    [
     "4",
     "Client",
     "Sends no frames if the Accept value is missing or wrong"
    ],
    [
     "5",
     "Both",
     "Switch to the binary frame-based protocol, sending in either direction"
    ]
   ],
