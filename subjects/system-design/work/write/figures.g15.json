 "sysd-msg-099": [
  {
   "type": "table",
   "caption": "Two families give four techniques: the browser polls, or browser and server cooperate.",
   "header": [
    "Technique",
    "Who does the work",
    "How updates arrive"
   ],
   "rows": [
    [
     "Short polling",
     "Browser",
     "Keeps retrying until it gets the latest data"
    ],
    [
     "Long polling",
     "Browser",
     "Server holds its result until new data arrives"
    ],
    [
     "WebSocket",
     "Browser and server",
     "Full-duplex: the browser can keep sending requests"
    ],
    [
     "Server-sent events",
     "Browser and server",
     "One-way: the browser cannot send new requests"
    ]
   ],
