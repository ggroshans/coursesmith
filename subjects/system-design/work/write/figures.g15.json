 "sysd-msg-003": [
  {
   "type": "table",
   "caption": "Six constraints define REST; only code on demand is optional.",
   "header": [
    "Constraint",
    "What it means"
   ],
   "rows": [
    [
     "Uniform interface",
     "One uniform way to interact with a given server"
    ],
    [
     "Client-server",
     "Clients and servers separated by a well-defined interface"
    ],
    [
     "Stateless",
     "No client context kept on the server between requests"
    ],
    [
     "Cacheable",
     "Each response says whether and how long it can be cached"
    ],
    [
     "Layered system",
     "A client cannot tell the end server from an intermediary"
    ],
    [
     "Code on demand",
     "Optional: servers extend a client with executable logic"
    ]
   ],
