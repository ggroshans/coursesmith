{"title": "Raised field", "kind": "Practice", "weight": "Minor", "level": "Foundational", "article": "Raised field", "definition": {"text": "A large cultivated mound, usually bounded by water-filled ditches, used to control moisture, frost damage and flooding.", "sent_ids": ["1e131181ab6d"]}, "facts": [{"text": "Raised fields were used by Pre-Hispanic cultures of Latin America, for example in the Llanos de Moxos of lowland Bolivia.", "sent_ids": ["21e198320ab3", "5360e9e63ca3"]}, {"text": "The Tiwanaku culture used them near Lake Titicaca, where the technique is called Waru Waru.", "sent_ids": ["c870bea39a3b"]}, {"text": "The Maya farmed raised fields at Pulltrouser Swamp in Belize, and the Aztecs built chinampas on Lake Texcoco.", "sent_ids": ["1ccf915b5e0b", "14209362b9fc"]}], "prerequisites": ["soil-water-214"], "related": ["soil-fert-086", "soil-hist-100"], "contested": false, "contested_note": null, "conflicts": [], "distinct_from": [], "wants_image": false, "notes": null, "part": "History, people and frontiers", "chapter": "Forensic and archaeological soil science", "id": "soil-hist-101", "score": 2.0, "score_parts": {"importance": 0.0, "weight": 0, "tests": 1, "pages": 1.0, "builds_on_it": 0.0}, "selected": true, "unit": 560, "position": 4, "verification": [], "external": [], "source_tier": "wikipedia", "curriculum": ["own article"], "sources": [{"title": "Raised field", "url": "https://en.wikipedia.org/wiki/Raised_field", "revid": 1303084386, "sent_ids": ["21e198320ab3", "5360e9e63ca3", "c870bea39a3b", "1ccf915b5e0b", "14209362b9fc", "1e131181ab6d"], "key": "Raised field", "source": "wikipedia", "version": "1303084386"}], "events": [], "flags": [], "qid": "Q7285120", "prerequisites_draft": [], "prerequisite_sources": {"soil-water-214": "ordering pass"}}
{"title": "Midden", "kind": "Material", "weight": "Minor", "level": "Foundational", "article": "Midden", "definition": {"text": "An old dump for domestic waste.", "sent_ids": ["985cde2d1e57"]}, "facts": [{"text": "Middens may hold animal bones, human excrement, plant material, mollusc shells, potsherds and stone tools.", "sent_ids": ["ff39977fe88b"]}, {"text": "Damp, anaerobic conditions in a midden can preserve organic remains.", "sent_ids": ["f667f0d7e9bd"]}, {"text": "Shell middens are alkaline from calcium carbonate, which slows decay by soil acidity and preserves organic material.", "sent_ids": ["db9b183bf4cf", "7e1d84c35cf9"]}, {"text": "Sediment laid down by wind, water and animal digging forms a matrix that yields seasonal and climatic information.", "sent_ids": ["e085514b1ca5", "4b5671268224"]}], "prerequisites": ["soil-bio-114", "soil-found-014"], "related": ["soil-class-053", "soil-class-057", "soil-hist-094", "soil-hist-088"], "contested": false, "contested_note": null, "conflicts": [], "distinct_from": [], "wants_image": false, "notes": null, "part": "History, people and frontiers", "chapter": "Forensic and archaeological soil science", "id": "soil-hist-102", "score": 4.2, "score_parts": {"importance": 2.197, "weight": 0, "tests": 1, "pages": 1.0, "builds_on_it": 0.0}, "selected": true, "unit": 557, "position": 5, "verification": [], "external": [], "source_tier": "wikipedia", "curriculum": ["own article"], "sources": [{"title": "Midden", "url": "https://en.wikipedia.org/wiki/Midden", "revid": 1384163176, "sent_ids": ["ff39977fe88b", "f667f0d7e9bd", "db9b183bf4cf", "7e1d84c35cf9", "e085514b1ca5", "4b5671268224", "985cde2d1e57"], "key": "Midden", "source": "wikipedia", "version": "1384163176"}], "events": [], "flags": [], "qid": "Q1152199", "prerequisites_draft": ["soil-found-014"], "prerequisite_sources": {"soil-bio-114": "ordering pass", "soil-found-014": "consolidation"}}
